        "# Candidate-Elimination Algorithm\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# Create training data\n",
        "data = {\n",
        "    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],\n",
        "    'AirTemp': ['Warm', 'Warm', 'Cold', 'Warm'],\n",
        "    'Humidity': ['Normal', 'High', 'High', 'High'],\n",
        "    'Wind': ['Strong', 'Strong', 'Strong', 'Strong'],\n",
        "    'Water': ['Warm', 'Warm', 'Warm', 'Cool'],\n",
        "    'Forecast': ['Same', 'Same', 'Change', 'Change'],\n",
        "    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Save data as CSV\n",
        "df.to_csv('training_data.csv', index=False)\n",
        "\n",
        "# Read CSV file\n",
        "data = pd.read_csv('training_data.csv')\n",
        "\n",
        "print(\"Training Data:\")\n",
        "print(data)\n",
        "\n",
        "\n",
        "# Candidate-Elimination Algorithm\n",
        "\n",
        "attributes = list(data.columns[:-1])\n",
        "\n",
        "# Initial Specific Hypothesis\n",
        "S = ['Ø'] * len(attributes)\n",
        "\n",
        "# Initial General Hypothesis\n",
        "G = [['?'] * len(attributes)]\n",
        "\n",
        "\n",
        "# Function to check whether hypothesis covers example\n",
        "def covers(h, example):\n",
        "    for i in range(len(h)):\n",
        "        if h[i] != '?' and h[i] != 'Ø' and h[i] != example[i]:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "\n",
        "# Generalize Specific hypothesis\n",
        "def generalize_S(S, example):\n",
        "    new_S = S.copy()\n",
        "\n",
        "    for i in range(len(S)):\n",
        "        if S[i] == 'Ø':\n",
        "            new_S[i] = example[i]\n",
        "        elif S[i] != example[i]:\n",
        "            new_S[i] = '?'\n",
        "\n",
        "    return new_S\n",
        "\n",
        "\n",
        "# Specialize General hypothesis\n",
        "def specialize_G(G, example, domains, S):\n",
        "    new_G = []\n",
        "\n",
        "    for g in G:\n",
        "        if covers(g, example):\n",
        "            for i in range(len(g)):\n",
        "                if g[i] == '?':\n",
        "                    for value in domains[i]:\n",
        "                        if value != example[i]:\n",
        "                            new_g = g.copy()\n",
        "\n",
        "                            if S[i] == 'Ø' or S[i] == '?' or value == S[i]:\n",
        "                                new_g[i] = value\n",
        "                                new_G.append(new_g)\n",
        "        else:\n",
        "            new_G.append(g)\n",
        "\n",
        "    return new_G\n",
        "\n",
        "\n",
        "# Get all possible values for each attribute\n",
        "domains = []\n",
        "\n",
        "for attribute in attributes:\n",
        "    domains.append(list(data[attribute].unique()))\n",
        "\n",
        "\n",
        "# Candidate-Elimination\n",
        "for index, row in data.iterrows():\n",
        "\n",
        "    example = list(row[:-1])\n",
        "    label = row.iloc[-1]\n",
        "\n",
        "    if label == 'Yes':\n",
        "\n",
        "        # Remove hypotheses from G that do not cover positive example\n",
        "        G = [g for g in G if covers(g, example)]\n",
        "\n",
        "        # Generalize S\n",
        "        S = generalize_S(S, example)\n",
        "\n",
        "        # Keep only G hypotheses consistent with S\n",
        "        G = [\n",
        "            g for g in G\n",
        "            if all(\n",
        "                s == '?' or s == 'Ø' or g[i] == '?' or g[i] == s\n",
        "                for i, s in enumerate(S)\n",
        "            )\n",
        "        ]\n",
        "\n",
        "    else:\n",
        "\n",
        "        # Remove hypotheses from G that cover negative example\n",
        "        G = [g for g in G if not covers(g, example)]\n",
        "\n",
        "        # Specialize G\n",
        "        G = specialize_G(G, example, domains, S)\n",
        "\n",
        "\n",
        "print(\"\\nFinal Specific Boundary (S):\")\n",
        "print(S)\n",
        "\n",
        "print(\"\\nFinal General Boundary (G):\")\n",
        "\n",
        "for g in G:\n",
        "    print(g)"
